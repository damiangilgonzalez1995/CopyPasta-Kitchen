# Committed defaults (public: only VITE_* vars reach the browser, never put secrets here). Override locally in .env.local.

# http | fake. `fake` runs the whole app without backend (demos, e2e, frontend-only work).
VITE_API_MODE=http
# Base URL of the backend API. Relative ("/api") uses the Vite proxy in dev and the same origin in prod.
VITE_API_URL=/api
